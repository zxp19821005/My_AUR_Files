pkgname=workbuddy
_pkgname=WorkBuddy
_mainver=5.4.7
_subver=37521366_b148bd1d
pkgver="${_mainver}.${_subver}"
_electronversion=42
pkgrel=100
pkgdesc="Work Smart，Not Hard"
arch=(
    'aarch64'
    'x86_64'
)
url="https://www.codebuddy.ai/agents"
license=('LicenseRef-custom')
depends=(
    "electron${_electronversion}"
    'nodejs'
    'python'
    'python-httpx'
    'python-requests'
    'python-numpy'
    'python-pillow'
    'python-click'
    'python-beautifulsoup4'
)
makedepends=(
    '7zip'
    'npm'
    'libicns'
    'asar'
    'python'
    'sqlite'
    'nvm'
)
optdepends=(
    'nodejs-lts: frontend skills'
    'gnome-shell-extension-appindicator'
)
source=(
    "${pkgname}-${pkgver}-${CARCH}.dmg::https://download.codebuddy.cn/workbuddy/saas/darwin-x64/${_pkgname}-darwin-x64-${pkgver//_/-}.dmg"
    "${pkgname}.desktop"
    "better-sqlite3.tgz::https://registry.npmmirror.com/better-sqlite3/-/better-sqlite3-13.0.3.tgz"
    "node-pty.tgz::https://registry.npmmirror.com/@lydell/node-pty/-/node-pty-1.2.0-beta.14.tgz"
    "snappy-linux-x64-gnu.node::https://github.com/Brooooooklyn/snappy/releases/download/v7.3.3/snappy.linux-x64-gnu.node"
    "snappy-linux-x64-musl.node::https://github.com/Brooooooklyn/snappy/releases/download/v7.3.3/snappy.linux-x64-musl.node"
    "sandbox-cli-linux-x64.tgz::https://mirrors.cloud.tencent.com/npm/@tencent-ai/sandbox-cli-linux-x64/-/sandbox-cli-linux-x64-5.5.6.tgz"
    "${pkgname}.sh"
)
options=(
    '!strip'
    '!emptydirs'
)
noextract=(
    "better-sqlite3.tgz"
    "node-pty.tgz"
    "snappy-linux-x64-gnu.node"
    "snappy-linux-x64-musl.node"
    "sandbox-cli-linux-x64.tgz"
)
sha256sums=('cd72489d8a72f6b30fbf314be95f2600dbe23aa01445eacf11c3159b37a07da8'
            'c7d14a0303000dfac2bbb31e82916814cccfbeddb9d4c0c5d08f8d344d27f07a'
            '77e0513dc1a469fb3bceec4c7fb5ad3f403109787eda05be047ec17fd56868cb'
            'eee8e260e43b96aa5450f4c95f05de1b48ab24fcb3d4ef566232ec9ccff2e39e'
            '42ac694666e35e21b96d09c374b89918acd7d95297d1adfd9d31edb4fb7a5ebb'
            '31eb00fd08d44f3379d51074159bae843ed94c84c2c83dc13612e3664627084e'
            '9011a2f83532ca9d1a95c8172e292a9cc57da3af2c5417cf380aef76e3b4f881'
