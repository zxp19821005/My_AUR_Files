_ensure_local_nvm() {
    local NVM_DIR="${srcdir}/.nvm"
    source /usr/share/nvm/init-nvm.sh || [[ $? != 1 ]]
    nvm install "${_nodeversion}"
    nvm use "${_nodeversion}"
}
prepare() {
    sed -i -e "
        s/@electronversion@/${_electronversion}/g
        s/@appname@/${pkgname%-bin}/g
        s/@runname@/app.asar.unpacked/g
        s/@cfgdirname@/${pkgname%-bin}/g
    " "${srcdir}/${pkgname%-bin}.sh"
    7z x -snld -aoa "${srcdir}/${pkgname}-${pkgver}-${CARCH}.dmg"
    cd "${srcdir}/${_pkgname} ${_mainver}/${_pkgname}.app/Contents/Resources"
    icns2png -x icon.icns -o "${srcdir}"
    asar e app.asar app.asar.unpacked || continue
    find app.asar.unpacked -type f -exec sed -i "s/process.resourcesPath/\'\/usr\/lib\/${pkgname}\'/g" {} +    
    local _unpacked_dir="${srcdir}/${_pkgname} ${_mainver}/${_pkgname}.app/Contents/Resources/app.asar.unpacked"
    rm -rf "${_unpacked_dir}/node_modules/"{better-sqlite3,@lydell/node-pty-linux*}
    mkdir -p "${srcdir}/tmp/"{better-sqlite3,node-pty-linux}
    bsdtar -xf "${srcdir}/better-sqlite3.tgz" -C "${srcdir}/tmp/better-sqlite3"
    rm -rf "${srcdir}/tmp/better-sqlite3/package/prebuilds/"{darwin-*,*-arm64*,win32-*}
    bsdtar -xf "${srcdir}/node-pty.tgz" -C "${srcdir}/tmp/node-pty-linux"
    mkdir -p "${_unpacked_dir}/node_modules/"{better-sqlite3,@lydell/node-pty-linux-x64}
    cp -a "${srcdir}/tmp/better-sqlite3/package/"* "${_unpacked_dir}/node_modules/better-sqlite3"
    cp -a "${srcdir}/tmp/node-pty-linux/package/"* "${_unpacked_dir}/node_modules/@lydell/node-pty-linux-x64"
    # 删除 macOS 专属文件，减少包体积
    rm -rf \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-darwin-arm64" \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-darwin-x64" \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-linux-arm64" \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-win32-arm64" \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-win32-x64" \
        "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-darwin-x64" \
        "${_unpacked_dir}/cli/vendor/genie-trash/darwin-x64" \
        "${_unpacked_dir}/cli/vendor/shim/native" \
        "${_unpacked_dir}/cli/vendor/toybox-macos" \
        "${_unpacked_dir}/cli/vendor/zsh-macos" \
        "${_unpacked_dir}/cli/vendor/ripgrep/"{x64-darwin,arm64-darwin,x64-win32} \
        "${_unpacked_dir}/cli/vendor/sandbox" \
        "${_unpacked_dir}/node_modules/koffi/build/koffi/"{freebsd*,openbsd*,*arm*,linux_ia32,linxu_loong64,linux_riscv64d} \
        "${_unpacked_dir}/native/wechat-copydata-decoder"
    find "${_unpacked_dir}/node_modules" -type d \
        \( -name "*-arm64*" -o -name "*darwin*" -o -name "*win32*" \) \
        -exec rm -rf {} +
    # Install Linux native bindings for snappy (not included in macOS DMG)
    mkdir -p "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-gnu"
    mkdir -p "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-musl"
    cp "${srcdir}/snappy-linux-x64-gnu.node" "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-gnu/snappy.linux-x64-gnu.node"
    cp "${srcdir}/snappy-linux-x64-musl.node" "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-musl/snappy.linux-x64-musl.node"
    # Create package.json for snappy-linux-x64-gnu
    cat > "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-gnu/package.json" << 'EOF'
{
  "name": "@napi-rs/snappy-linux-x64-gnu",
  "version": "7.3.3",
  "cpu": ["x64"],
  "os": ["linux"],
  "main": "snappy.linux-x64-gnu.node",
  "files": ["snappy.linux-x64-gnu.node"],
  "license": "MIT",
  "engines": { "node": ">= 10" }
}
EOF
    # Create package.json for snappy-linux-x64-musl
    cat > "${_unpacked_dir}/cli/node_modules/@napi-rs/snappy-linux-x64-musl/package.json" << 'EOF'
{
  "name": "@napi-rs/snappy-linux-x64-musl",
  "version": "7.3.3",
  "cpu": ["x64"],
  "os": ["linux"],
  "main": "snappy.linux-x64-musl.node",
  "files": ["snappy.linux-x64-musl.node"],
  "license": "MIT",
  "engines": { "node": ">= 10" }
}
EOF
    # Install Linux version of sandbox-cli (from @tencent-ai/sandbox-cli-linux-x64)
    mkdir -p "${srcdir}/tmp/sandbox-cli"
    bsdtar -xf "${srcdir}/sandbox-cli-linux-x64.tgz" -C "${srcdir}/tmp/sandbox-cli"
    mkdir -p "${_unpacked_dir}/cli/vendor/sandbox/5.5.6"
    cp "${srcdir}/tmp/sandbox-cli/package/bin/sandbox-cli" "${_unpacked_dir}/cli/vendor/sandbox/5.5.6/"
    cp "${srcdir}/tmp/sandbox-cli/package/bin/sandbox-center" "${_unpacked_dir}/cli/vendor/sandbox/5.5.6/"
    cp "${srcdir}/tmp/sandbox-cli/package/bin/betterleaks" "${_unpacked_dir}/cli/vendor/sandbox/5.5.6/"
    chmod +x "${_unpacked_dir}/cli/vendor/sandbox/5.5.6/"*
    # Fix 1: Use setContextMenu for Linux tray (required for KDE Plasma 6 + Electron 42 compatibility)
    # This ensures the tray menu is registered with StatusNotifierWatcher and works on all Linux DEs
    sed -i \
        -e 's/const contextMenu = electron\.Menu\.buildFromTemplate/this.trayContextMenu = electron.Menu.buildFromTemplate/' \
        -e 's/this\.tray\.setContextMenu(contextMenu)/this.tray.setContextMenu(this.trayContextMenu)/' \
        -e 's/this\.tray?\.popUpContextMenu(contextMenu)/this.tray.setContextMenu(this.trayContextMenu)/' \
        "${_unpacked_dir}/main/index.js"
    # Fix 2: Add will-quit safety net to guarantee process exit when cleanup hangs
    cat >> "${_unpacked_dir}/main/index.js" << 'PATCH_EOF'
// will-quit safety: if performQuitCleanup hangs (daemon unreachable, network timeout),
// this handler forces exit to prevent the app from becoming unresponsive.
electron.app.on("will-quit", (event) => {
	// Force exit: prevent any possibility of process hanging
	event.preventDefault();
	require_logger.mainLog.warn("[Lifecycle] will-quit: force exit immediately");
	// Kill all helper processes first
	setTimeout(() => electron.app.exit(0), 100);
});
PATCH_EOF
}
package() {
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm755 -d "${pkgdir}/usr/lib/${pkgname}"
    cp -a "${srcdir}/${_pkgname} ${_mainver}/${_pkgname}.app/Contents/Resources/app.asar.unpacked" "${pkgdir}/usr/lib/${pkgname}"
    icon_sizes=(256x256 512x512 1024x1024)
    for _icons in "${icon_sizes[@]}";do
        install -Dm644 "${srcdir}/icon_${_icons}x32.png" \
            "${pkgdir}/usr/share/icons/hicolor/${_icons}/apps/${pkgname}.png"
    done
    install -Dm644 "${srcdir}/${pkgname}.desktop" -t "${pkgdir}/usr/share/applications"
}
