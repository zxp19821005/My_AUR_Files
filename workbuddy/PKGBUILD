pkgname=workbuddy
_pkgname=WorkBuddy
pkgver=5.3.12.35805101_a981f41f
_electronversion=42
_nodeversion=24.18.1
pkgrel=1
pkgdesc="Work Smart，Not Hard"
arch=(
    'aarch64'
    'x86_64'
)
url="https://www.codebuddy.ai/agents"
license=('LicenseRef-custom')
depends=(
    "electron${_electronversion}"
    'nodejs'
    'python'
    'python-httpx'
    'python-requests'
    'python-numpy'
    'python-pillow'
    'python-click'
    'python-beautifulsoup4'
)
makedepends=(
    '7zip'
    'npm'
    'libicns'
    'asar'
    'python'
    'sqlite'
    'nvm'
)
optdepends=(
    'nodejs-lts: frontend skills'
    'gnome-shell-extension-appindicator'
)
source=(
    "${pkgname}-${pkgver}-${CARCH}.dmg::https://download.codebuddy.cn/workbuddy/saas/darwin-x64/${_pkgname}-darwin-x64-${pkgver//_/-}.dmg"
    "${pkgname}.desktop"
    "better-sqlite3.tgz::https://registry.npmmirror.com/better-sqlite3/-/better-sqlite3-13.0.3.tgz"
    "node-pty.tgz::https://registry.npmmirror.com/@lydell/node-pty/-/node-pty-1.2.0-beta.15.tgz"
    "${pkgname}.sh"
)
options=(
    '!strip'
    '!emptydirs'
)
noextract=(
    "better-sqlite3.tgz"
    "node-pty.tgz"
)
sha256sums=('6bd78dd8733fdfb22cac7c0b024ffe8b0174afe00a4a539560cd5c7c103462b5'
            'c7d14a0303000dfac2bbb31e82916814cccfbeddb9d4c0c5d08f8d344d27f07a'
            '77e0513dc1a469fb3bceec4c7fb5ad3f403109787eda05be047ec17fd56868cb'
            'c28df2b8de694493420c9f090c53f1cc9d087b64ba7b6b59e262588198688ef5'
            'a774c2f54fbbeeaac3cefc0f7250796d30c86d27f0fd40b7eaf9c0fdb021623d')
_ensure_local_nvm() {
    local NVM_DIR="${srcdir}/.nvm"
    source /usr/share/nvm/init-nvm.sh || [[ $? != 1 ]]
    nvm install "${_nodeversion}"
    nvm use "${_nodeversion}"
}
prepare() {
    sed -i -e "
        s/@electronversion@/${_electronversion}/g
        s/@appname@/${pkgname%-bin}/g
        s/@runname@/app.asar.unpacked/g
        s/@cfgdirname@/${pkgname%-bin}/g
    " "${srcdir}/${pkgname%-bin}.sh"
    #7z x -snld -aoa "${srcdir}/${pkgname}-${pkgver}-${CARCH}.dmg"
    cd "${srcdir}/${_pkgname}.app/Contents/Resources"
    #icns2png -x icon.icns -o "${srcdir}"
    #asar e app.asar app.asar.unpacked || continue
    find app.asar.unpacked -type f -exec sed -i "s/process.resourcesPath/\'\/usr\/lib\/${pkgname}\'/g" {} +    
    local _unpacked_dir="${srcdir}/${_pkgname}.app/Contents/Resources/app.asar.unpacked"
    rm -rf "${_unpacked_dir}/node_modules/"{better-sqlite3,@lydell/node-pty-linux*}
    mkdir -p "${srcdir}/tmp/"{better-sqlite3,node-pty-linux}
    bsdtar -xf "${srcdir}/better-sqlite3.tgz" -C "${srcdir}/tmp/better-sqlite3"
    rm -rf "${srcdir}/tmp/better-sqlite3/package/prebuilds/"{darwin-*,*-arm64*,win32-*}
    bsdtar -xf "${srcdir}/node-pty.tgz" -C "${srcdir}/tmp/node-pty-linux"
    mkdir -p "${_unpacked_dir}/node_modules/"{better-sqlite3,@lydell/node-pty-linux-x64}
    mv "${srcdir}/tmp/better-sqlite3/package/"* "${_unpacked_dir}/node_modules/better-sqlite3"
    mv "${srcdir}/tmp/node-pty-linux/package/"* "${_unpacked_dir}/node_modules/@lydell/node-pty-linux-x64"
    # 删除 macOS 专属文件，减少包体积
    rm -rf \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-darwin-arm64" \
        "${_unpacked_dir}/cli/node_modules/@lydell/node-pty-darwin-x64" \
        "${_unpacked_dir}/cli/vendor/genie-trash/darwin-x64" \
        "${_unpacked_dir}/cli/vendor/ripgrep/x64-darwin" \
        "${_unpacked_dir}/cli/vendor/ripgrep/arm64-darwin" \
        "${_unpacked_dir}/cli/vendor/ripgrep/x64-win32" \
        "${_unpacked_dir}/cli/vendor/sandbox/5.3.3/sandbox-cli" \
        "${_unpacked_dir}/native/wechat-copydata-decoder"
    find "${_unpacked_dir}/node_modules" -type d \
        \( -name "*-arm64*" -o -name "*darwin*" -o -name "*win32*" \) \
        -exec rm -rf {} +
}
package() {
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm755 -d "${pkgdir}/usr/lib/${pkgname}"
    cp -a "${srcdir}/${_pkgname}.app/Contents/Resources/app.asar.unpacked" "${pkgdir}/usr/lib/${pkgname}"
    icon_sizes=(256x256 512x512 1024x1024)
    for _icons in "${icon_sizes[@]}";do
        install -Dm644 "${srcdir}/icon_${_icons}x32.png" \
            "${pkgdir}/usr/share/icons/hicolor/${_icons}/apps/${pkgname}.png"
    done
    install -Dm644 "${srcdir}/${pkgname}.desktop" -t "${pkgdir}/usr/share/applications"
}
