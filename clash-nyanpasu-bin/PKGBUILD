pkgname=clash-nyanpasu-bin
_pkgname=Clash.Nyanpasu
pkgver=2.0.0
pkgrel=99
pkgdesc="A Clash GUI based on tauri. Clash Nyanpasu! (∠・ω< )⌒☆​"
arch=(
    'aarch64'
    'x86_64'
)
url="https://nyanpasu.org/"
_ghurl="https://github.com/libnyanpasu/clash-nyanpasu"
license=('GPL-3.0-only')
provides=("${pkgname%-bin}=${pkgver}")
conflicts=("${pkgname%-bin}")
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'mihomo'
    'clash-rs'
    'libayatana-appindicator'
)
optdepends=(
    'clash: A rule based proxy in Go'
)
options=(
    '!strip'
)
source_aarch64=("${pkgname%-bin}-${pkgver}-aarch64.rpm::${_ghurl}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-1.aarch64.rpm")
source_x86_64=("${pkgname%-bin}-${pkgver}-x86_64.rpm::${_ghurl}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-1.x86_64.rpm")
sha256sums_aarch64=('cc088944a565de1ef3cd6b655b4cd5c620d9b09837558775b2d728a458daa3da')
sha256sums_x86_64=('f0293142593e55f6cc28ad217d97bade7b79ff747ebf5b202b4a2b6cde0058e6')
prepare() {
    sed -i -e "
        s/Development/Network/g
        s/Exec=\"${_pkgname//./ }\"/Exec=${pkgname%-bin}/g
        s/Icon=${_pkgname//./ }/Icon=${pkgname%-bin}/g
    " "${srcdir}/usr/share/applications/${_pkgname//./ }.desktop"
    local _icon_dir="${srcdir}/usr/share/icons/hicolor"
	[[ -d "${_icon_dir}/256x256@2" && ! -d "${_icon_dir}/512x512" ]] && mv "${_icon_dir}/256x256@2" "${_icon_dir}/512x512"
    rm -rf "${srcdir}/usr/bin/"{mihomo,clash,clash-rs}
}
package() {
    install -Dm755 "${srcdir}/usr/bin/"* -t "${pkgdir}/usr/bin"
    mv "${pkgdir}/usr/bin/${_pkgname//./ }" "${pkgdir}/usr/bin/${pkgname%-bin}"
    [ -d "${srcdir}/usr/lib" ] && cp -a "${srcdir}/usr/lib" "${pkgdir}/usr/"
    find "${srcdir}" -type f \( -name "*.png" -o -name "*.svg" \) -path "*share/icons/*" | while read -r _i; do
		_extension="${_i##*.}"
		_icon_path="${_i#*share/icons/}"
		_target_dir="/usr/share/icons/$(dirname "${_icon_path}")"
		install -Dm644 "${_i}" "${pkgdir}${_target_dir}/${pkgname%-bin}.${_extension}"
	done
    install -Dm644 "${srcdir}/usr/share/applications/${_pkgname//./ }.desktop" "${pkgdir}/usr/share/applications/${pkgname%-bin}.desktop"
}
