_appname=buddycn
pkgname=codebuddy-ide-cn
_cb_ver=4.11.1
_cb_build=36020259
_cb_hash=b72e1c95
pkgver="${_cb_ver}.${_cb_build}"
_electronversion=37
pkgrel=99
pkgdesc='腾讯云代码助手CodeBuddy IDE，是一款辅助编码工具。'
arch=('x86_64')
url='https://www.codebuddy.cn/ide'
license=('LicenseRef-Tencent-CodeBuddy')
depends=(
    "electron${_electronversion}"
    'nodejs'
    'python'
    'perl'
    'python-fonttools'
    'python-requests'
)
optdepends=(
    'bash'
    'zsh'
)
options=(
    '!emptydirs'
    '!strip'
)
source=(
    "${pkgname}-${pkgver}.deb::https://download.codebuddy.cn/aiide/linux-x64/CodeBuddy-linux-x64-${pkgver}-${_cb_hash}-cn.deb"
    "${pkgname%-bin}.js"
    "${pkgname}.sh"
)
sha256sums=('54a51b2d7fb3f1eec695cb1608b8adf4260adeb820a4f896ba720447175ac4a3'
            '7503a07a6b1ce191a902f9bb418da852c628940e7e864a85c49fb4712ab35f75'
            '700067aa4b354a91ab3374b5495af9eb3093855a3d8016a8303e88abf3470599')
_get_app_dir() {
    find "${srcdir}" -type f -name "resources.pak" -exec dirname {} + | head -n 1
}
_check_electron_version() {
    echo "Verifying Electron version..."
    local _main_exe=$(find "$(_get_app_dir)" -maxdepth 1 -type f -executable -printf '%s %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
    [[ -z "${_main_exe}" ]] && echo -e "\033[1;33mNote: Could not find Electron binary.\033[0m" && return
    local _elec_ver=$(strings "${_main_exe}" | grep -oP 'Electron/\K[0-9]+' | head -1)
    [[ -z "${_elec_ver}" ]] && echo -e "\033[1;33mNote: Could not determine Electron version.\033[0m" && return
    [[ "${_elec_ver}" != "${_electronversion}" ]] &&
        echo -e "\033[1;31mWarning: Electron version mismatch! Detected: ${_elec_ver}, Expected: ${_electronversion}\033[0m" ||
        echo -e "Electron version verified: \033[1;31m${_elec_ver}\033[0m"
}
prepare() {
    sed -i -e "
        s/@electronversion@/${_electronversion}/g
        s/@appname@/${pkgname}/g
        s/@runname@/app/g
        s/@cfgdirname@/${_pkgname}/g
    " "${srcdir}/${pkgname}.sh"
    bsdtar -xf "${srcdir}/data."*
    _check_electron_version
    sed -i "s/@ELECTRON@/electron${_electronversion}/g" "${srcdir}/${pkgname}.js"
    sed -i -e "
        s/Exec=\/usr\/share\/${_appname}\/bin\/${_appname}/Exec=${pkgname}/g
        s/Icon=${_appname}/Icon=${pkgname}/g
    " "${srcdir}/usr/share/applications/${_appname}"*.desktop
    sed -i -e "
        s/@@NAME@@/${pkgname}/g
        s/@@NAME_LONG@@/${pkgname}/g
    " "${srcdir}/usr/share/appdata/${_appname}.appdata.xml"
    sed -i "s/@@NAME_LONG@@/${pkgname}/g" "${srcdir}/usr/share/mime/packages/${_appname}-workspace.xml"
    local _app_dir=$(_get_app_dir)
    find "${_app_dir}/resources/app" -name "win32-*" -name "*.node" -delete
}
package() {
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    install -Dm755 "${srcdir}/${pkgname}.js" -t "${pkgdir}/usr/lib/${pkgname}"
    local _app_dir=$(_get_app_dir)
    cp -a "${_app_dir}/resources/app/"* "${pkgdir}/usr/lib/${pkgname}/"
    install -Dm644 "${srcdir}/usr/share/pixmaps/${_appname}.png" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
    install -Dm644 "${srcdir}/usr/share/applications/${_appname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    install -Dm644 "${srcdir}/usr/share/applications/${_appname}-url-handler.desktop" "${pkgdir}/usr/share/applications/${pkgname}-url-handler.desktop"
    install -Dm644 "${srcdir}/usr/share/appdata/${_appname}.appdata.xml" "${pkgdir}/usr/share/appdata/${pkgname}.appdata.xml"
    install -Dm644 "${srcdir}/usr/share/mime/packages/${_appname}-workspace.xml" "${pkgdir}/usr/share/mime/packages/${pkgname}-workspace.xml"
    if [ -x "/usr/bin/zsh" ];then
        install -Dm644 "${_app_dir}/resources/completions/bash/${_appname}" "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
    fi
    if [ -x "/usr/bin/zsh" ];then
        install -Dm644 "${_app_dir}/resources/completions/zsh/_${_appname}" "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
    fi
    install -Dm644 "${_app_dir}/resources/app/LICENSE.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
