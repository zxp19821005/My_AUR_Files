# Maintainer: taotieren <admin@taotieren.com>
pkgname=115-browser-bin
_pkgname=115br
_appname=115Browser
# 版本更新检查页面：https://appversion.115.com/1/web/1.0/api/getMultiVer
pkgver=36.0.1
pkgrel=99
pkgdesc="115 Browser / 115 浏览器"
arch=('x86_64')
url="https://115.com/product_browser"
license=('LicenseRef-scancode-commercial-license')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
options=(
    '!strip'
    '!debug'
)
depends=(
    'expat'
    'libidn2'
    'libcups'
    'mesa'
    'nss'
    'at-spi2-core'
    'nspr'
    'alsa-lib'
    'libxrandr'
    'cairo'
    'libxkbcommon'
    'libxdamage'
    'libxcomposite'
    'pango'
    'qt5-base'
    'qt6-base'
)
source=(
    "${pkgname%-bin}-${pkgver}.deb::https://down.115.com/client/115pc/lin/${_pkgname}_v${pkgver}.deb"
    "LICENSE.html::http://115.com/privacy.html"
    "${pkgname%-bin}.sh"
)
sha256sums=('a26f84625b5c1ca1a7f6e2eb5a89327c49627fb7f04db1b71e27c48904b88d8b'
            '7a1c438a53cd10ad78b9ea150521f12e6d97e10cf07f07d38d4f0a65f22cafcf'
            '1bb3391bfe0f0a76d96ae3fcec1d7e981384e9536cec06009dfe5348b4d2b7c9')
prepare() {
    sed -i -e "
        s/@appname@/${pkgname%-bin}/g
        s/@runname@/${_appname}/g
    " "${srcdir}/${pkgname%-bin}.sh"
    bsdtar -xf "${srcdir}/data."*
    sed -i -e "
        /Exec=/d
        /Icon=/d
    " "${srcdir}/usr/share/applications/${_appname}.desktop"
    sed -i -e "
        4i\Exec=${pkgname%-bin}
        5i\Icon=${pkgname%-bin}
    " "${srcdir}/usr/share/applications/${_appname}.desktop"
}
package() {
    install -Dm755 "${srcdir}/${pkgname%-bin}.sh" "${pkgdir}/usr/bin/${pkgname%-bin}"
    install -Dm755 -d "${pkgdir}/usr/lib/${pkgname%-bin}"
    cp -a "${srcdir}/usr/local/${_appname}/"* "${pkgdir}/usr/lib/${pkgname%-bin}"
    install -Dm644 "${srcdir}/usr/share/applications/${_appname}.desktop" "${pkgdir}/usr/share/applications/${pkgname%-bin}.desktop"
    install -Dm644 "${srcdir}/usr/local/${_appname}/res/${_appname}.png" "${pkgdir}/usr/share/pixmaps/${pkgname%-bin}.png"
    install -Dm644 "${srcdir}/LICENSE.html" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
