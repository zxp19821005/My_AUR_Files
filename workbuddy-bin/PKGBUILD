# Maintainer: zxp19821005 <zxp19821005 at 163 dot com>
pkgname=workbuddy-bin
_pkgname=WorkBuddy
_debname="cn.${pkgname%-bin}.otohime"
pkgver=5.5.6
_electronversion=39
pkgrel=100
pkgdesc="Work Smart,Not Hard"
arch=(
    'aarch64'
    'x86_64'
)
url="https://www.workbuddy.cn/"
_dlurl="https://github.com/kota-rina3/hokeshi"
license=('AGPL-3.0-only')
provides=("${pkgname%-bin}=${pkgver}")
conflicts=("${pkgname%-bin}")
depends=(
    "electron${_electronversion}"
    'nodejs'
    'python'
    'python-click'
    'python-httpx'
    'python-requests'
    'python-numpy'
    'python-beautifulsoup4'
    'python-pillow'
)
makedepends=(
    'asar'
)
options=(
    '!strip'
    '!emptydirs'
)
source=(
    "${pkgname%-bin}.js"
    "${pkgname%-bin}.sh"
)
source_aarch64=("${pkgname%-bin}-${pkgver}-aarch64.deb::${_dlurl}/releases/download/${pkgname%-bin}-${pkgver}/${_debname}_${pkgver}_arm64.deb")
source_x86_64=("${pkgname%-bin}-${pkgver}-x86_64.deb::${_dlurl}/releases/download/${pkgname%-bin}-${pkgver}/${_debname}_${pkgver}_amd64.deb")
sha256sums=('562897be8a17076176f8d985c0d7bc1c685f2e7c9b3a932339ce015963243627'
            'd1e4e7e73d690e97039739dd1bf8f1eb046c2fd7e44305b15008ad842a503904')
sha256sums_aarch64=('644f12302f64035e1ac57a4ea9b8033a683a87a774a3e5fdd20c91413ac1e70e')
sha256sums_x86_64=('1decff1c164eb3b9bd3ca33e1750ad10ccdeeeb1de17ba934315c5b41481a024')
_get_app_dir() {
	find "${srcdir}" -type f -name "resources.pak" ! -path "*/node_modules/*" -printf '%h\n' 2>/dev/null \
		| while read -r d; do [[ -d "${d}/resources" ]] && { echo "$d"; return 0; }; done
}
_check_electron_version() {
	local _v=$(strings "$(find "$(_get_app_dir)" -maxdepth 1 -type f \
		-executable -printf '%s %p\n' | sort -nr | head -1 | cut -d' ' -f2-)" \
		| grep -oP 'Electron/\K[0-9]+' | head -1)
	[[ -z "$_v" ]] && { echo -e "\033[1;33mNote: Could not check version.\033[0m"; return; }
	(( _v == _electronversion )) && c=32 || c=31
	echo -e "Electron version: \033[1;${c}m$_v$([[ $c -eq 31 ]] && echo " (expected $_electronversion)")\033[0m"
}
_install_icons() {
	local _src="${1:-${srcdir}}" _name="${pkgname%-bin}" _icon _ext _size _dest
	while IFS= read -r -d '' _icon; do
		_ext="${_icon##*.}"
		_size=$(echo "${_icon%/*}" | grep -oE '[0-9]+x[0-9]+|scalable' | head -1)
		[[ -z "${_size}" ]] && _size=$([[ "${_ext}" == svg ]] && echo scalable || od -An -tu1 -j16 -N8 "${_icon}" 2>/dev/null | awk '{printf "%dx%d",$1*16777216+$2*65536+$3*256+$4,$5*16777216+$6*65536+$7*256+$8}')
		[[ "${_size}" =~ ^[0-9]+x[0-9]+$ ]] || _size=scalable
		_dest=$([[ "${_icon}" == */share/pixmaps/* ]] && echo pixmaps || echo "icons/hicolor/${_size}/apps")
		install -Dm644 "${_icon}" "${pkgdir}/usr/share/${_dest}/${_name}.${_ext}"
	done < <(find "${_src}" \( -path '*/share/icons/*' -o -path '*/share/pixmaps/*' -o -path '*entries/icons/*' \) -type f \( -name '*.png' -o -name '*.svg' \) -print0 2>/dev/null)
}
prepare() {
	sed -i -e "
		s/@electronversion@/${_electronversion}/g
		s/@appname@/${pkgname%-bin}/g
	" "${srcdir}/${pkgname%-bin}.sh" "${srcdir}/${pkgname%-bin}.js"
	bsdtar -xf "${srcdir}/data."*
	local _appdir="$(_get_app_dir)"
	_check_electron_version
	sed -i -e "
		s/Exec=\/opt\/apps\/${_debname}\/files\/${pkgname%-bin}/Exec=${pkgname%-bin} %U/g
		s/Icon=\/opt\/apps\/${_debname}\/files\/resources\/${_pkgname}.png/Icon=${pkgname%-bin}/g
		s/Categories=Office;/Categories=Network;Office;/g
	" "${srcdir}/opt/apps/${_debname}/entries/applications/${_pkgname}.desktop"
	rm -rf "${_appdir}/resources/elevate.exe"
	rm -rf "${srcdir}/app.asar.unpacked"
	asar e "${_appdir}/resources/app.asar" "${srcdir}/app.asar.unpacked" 2>/dev/null || true
	local _archrem=$([[ "${CARCH}" == "aarch64" ]] && echo x64 || echo arm)
	find "${_appdir}" "${srcdir}/app.asar.unpacked" -type d \
		\( -name '*darwin*' -o -name '*android*' -o -name 'win32*' -o -name "*ia32*" -o -name "*${_archrem}*" \) \
		-prune -exec rm -rf {} +
	{ grep -rlIZF 'process.resourcesPath' "${srcdir}/app.asar.unpacked" || true; } \
		| xargs -0 -r sed -i "s/process.resourcesPath/\'\/usr\/lib\/${pkgname%-bin}\'/g"
	local _refdir="${_appdir}/resources/app.asar.unpacked"
	while IFS= read -r -d '' _p; do
		if [[ -f "${srcdir}/app.asar.unpacked/${_p}" ]]; then
			chmod --reference="${_refdir}/${_p}" "${srcdir}/app.asar.unpacked/${_p}"
		fi
	done < <(find "${_refdir}" -type f -perm /111 -printf '%P\0' 2>/dev/null)
	local _bundle _patched=0
	while IFS= read -r -d '' _bundle; do
		sed -i -e '
			s#const listCache = .*new Map();#const listCache = (globalThis.__WB_LIST_CACHE__ ??= new Map());#
			s#const key = serializeListArgs(args);#const _argsKey = serializeListArgs(args); const key = _argsKey === void 0 ? void 0 : channel + "|" + _argsKey;#
			s#DEFAULT_LIST_THROTTLE_MS = 300;#DEFAULT_LIST_THROTTLE_MS = 3000;#
		' "${_bundle}"
		grep -qF '__WB_LIST_CACHE__' "${_bundle}" || return 1
		_patched=$(( _patched + 1 ))
	done < <(grep -rlZF --include='*.js' 'DEFAULT_LIST_THROTTLE_MS' \
		"${srcdir}/app.asar.unpacked/renderer/assets" || true)
	(( _patched > 0 )) || { echo "list cache patch: no target bundle found"; return 1; }
	rm -f "${_appdir}/resources/app.asar"
	rm -rf "${_refdir}"
}
package() {
	install -Dm755 "${srcdir}/${pkgname%-bin}.sh" "${pkgdir}/usr/bin/${pkgname%-bin}"
	install -Dm644 "${srcdir}/${pkgname%-bin}.js" -t "${pkgdir}/usr/lib/${pkgname%-bin}"
	find "$(_get_app_dir)/resources" -mindepth 1 -maxdepth 1 \
		! -name 'app.asar' ! -name 'app.asar.unpacked' ! -name 'elevate.exe' \
		-exec cp -a -t "${pkgdir}/usr/lib/${pkgname%-bin}" {} +
	cp -a "${srcdir}/app.asar.unpacked" "${pkgdir}/usr/lib/${pkgname%-bin}"
	_install_icons
	install -Dm644 "${srcdir}/opt/apps/${_debname}/entries/applications/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname%-bin}.desktop"
}
