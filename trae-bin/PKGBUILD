# Maintainer: Yahya Toubali <me@yahyatoubali.me>
pkgname=trae-bin
_pkgname=TraeCode
pkgver=2.3.73738
_electronversion=39
pkgrel=99
pkgdesc="AI-powered IDE by ByteDance - The Real AI Engine for code development"
arch=('x86_64')
url="https://trae.ai"
license=('MIT')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
depends=(
    'gtk3'
    'nss'
    'alsa-lib'
    'libxkbcommon'
    'python-importlib-metadata'
    'python-fonttools'
    'perl'
    'libxkbfile'
    'webkit2gtk-4.1'
    'libsecret'
    'zeromq'
    'python-packaging'
    'python-typing_extensions'
    'python'
    'nodejs'
)
optdepends=(
    'libvulkan: Vulkan support'
)
source=("${pkgname%-bin}.deb::https://lf-cdn.trae.ai/obj/trae-ai-us/pkg/app/releases/stable/${pkgver}/linux/${_pkgname}-linux-x64.deb")
sha256sums=('bdd45584a471c7cf98d092c529681703b1585cb275a893633f429a8eea0094db')
_get_app_dir() {
    find "${srcdir}" -type f -name "resources.pak" -exec dirname {} + | head -n 1
}
_check_electron_version() {
    echo "Verifying Electron version..."
    local _main_exe=$(find "$(_get_app_dir)" -maxdepth 1 -type f -executable -printf '%s %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
    [[ -z "${_main_exe}" ]] && echo -e "\033[1;33mNote: Could not find Electron binary.\033[0m" && return
    local _elec_ver=$(strings "${_main_exe}" | grep -oP 'Electron/\K[0-9]+' | head -1)
    [[ -z "${_elec_ver}" ]] && echo -e "\033[1;33mNote: Could not determine Electron version.\033[0m" && return
    [[ "${_elec_ver}" != "${_electronversion}" ]] &&
        echo -e "\033[1;31mWarning: Electron version mismatch! Detected: ${_elec_ver}, Expected: ${_electronversion}\033[0m" ||
        echo -e "Electron version verified: \033[1;31m${_elec_ver}\033[0m"
}
prepare() {
    bsdtar -xf "${srcdir}/data."*
    _check_electron_version
}
package() {
    cp -r "${srcdir}/usr" "${pkgdir}/"
    install -Dm755 -d "${pkgdir}/usr/bin"
    ln -sf "/usr/share/${pkgname%-bin}/bin/${pkgname%-bin}" "${pkgdir}/usr/bin/${pkgname%-bin}"
    if [ -f "${pkgdir}/usr/share/${pkgname%-bin}/resources/app/LICENSE.txt" ]; then
        install -Dm644 "$pkgdir/usr/share/${pkgname%-bin}/resources/app/LICENSE.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
    fi
    # 删除不必要的 locale（只保留 zh-CN 和 en-US）
    find "${pkgdir}/usr/share/${pkgname%-bin}/locales" -type f \
        ! -name 'zh-CN.pak' ! -name 'en-US.pak' -delete
    # 删除 Chromium License 文件（纯文本，运行时不需要）
    rm -f "${pkgdir}/usr/share/${pkgname%-bin}/LICENSES.chromium.html"
}
