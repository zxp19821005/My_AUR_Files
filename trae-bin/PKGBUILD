# Maintainer: Yahya Toubali <me@yahyatoubali.me>
pkgname=trae-bin
_pkgname=TRAE
pkgver=2.3.99397
_electronversion=39
pkgrel=99
pkgdesc="AI-powered IDE by ByteDance - The Real AI Engine for code development"
arch=('x86_64')
url="https://trae.ai"
license=('MIT')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
depends=(
    'gtk3'
    'nss'
    'alsa-lib'
    'libxkbcommon'
    'python-importlib-metadata'
    'python-fonttools'
    'perl'
    'libxkbfile'
    'webkit2gtk-4.1'
    'libsecret'
    'zeromq'
    'python-packaging'
    'python-typing_extensions'
    'python'
    'nodejs'
)
optdepends=(
    'libvulkan: Vulkan support'
)
options=('!strip')
source=("${pkgname%-bin}-${pkgver}.rpm::https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/${pkgver}/linux/${_pkgname}-linux-x64.rpm")
sha256sums=('4e3c826df3a99c98ef56579c091b97797da2c18e224dbf41ee7a004ecee5f015')
_get_app_dir() {
	find "${srcdir}" -type f -name "resources.pak" ! -path "*/node_modules/*" -printf '%h\n' 2>/dev/null \
		| while read -r d; do [[ -d "${d}/resources" ]] && { echo "$d"; return 0; }; done
}
_check_electron_version() {
	local _v=$(strings "$(find "$(_get_app_dir)" -maxdepth 1 -type f \
		-executable -printf '%s %p\n' | sort -nr | head -1 | cut -d' ' -f2-)" \
		| grep -oP 'Electron/\K[0-9]+' | head -1)
	[[ -z "$_v" ]] && { echo -e "\033[1;33mNote: Could not check version.\033[0m"; return; }
	(( _v == _electronversion )) && c=32 || c=31
	echo -e "Electron version: \033[1;${c}m$_v$([[ $c -eq 31 ]] && echo " (expected $_electronversion)")\033[0m"
}
prepare() {
    _check_electron_version
}
package() {
    cp -r "${srcdir}/usr" "${pkgdir}/"
    install -Dm755 -d "${pkgdir}/usr/bin"
    ln -sf "/usr/share/${pkgname%-bin}/bin/${pkgname%-bin}" "${pkgdir}/usr/bin/${pkgname%-bin}"
    if [ -f "${pkgdir}/usr/share/${pkgname%-bin}/resources/app/LICENSE.txt" ]; then
        install -Dm644 "$pkgdir/usr/share/${pkgname%-bin}/resources/app/LICENSE.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
    fi
    find "${pkgdir}/usr/share/${pkgname%-bin}/locales" -type f \
        ! -name 'zh-CN.pak' ! -name 'en-US.pak' -delete
    rm -f "${pkgdir}/usr/share/${pkgname%-bin}/LICENSES.chromium.html"
}
