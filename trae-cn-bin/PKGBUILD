pkgname=trae-cn-bin
_pkgname=TRAE_CN
pkgver=2.3.92182
_electronversion=39
pkgrel=99
pkgdesc="TRAE CN 桌面客户端（预编译二进制包）"
arch=('x86_64')
url="https://www.trae.cn/"
license=('LicenseRef-custom')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
depends=(
  'gtk3'
  'nss'
  'libxkbfile'
  'libsecret'
  'alsa-lib'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxrandr'
  'pango'
  'cairo'
  'at-spi2-core'
  'glib2'
  'expat'
  'nspr'
  'dbus'
  'libxkbcommon'
  'mesa'
  'python'
  'python-fonttools'
  'python-importlib-metadata'
  'python-typing_extensions'
  'python-packaging'
  'webkit2gtk-4.1'
  'nodejs'
  'ffmpeg'
  'ripgrep'
)
makedepends=(
  'librsvg'
)
optdepends=(
  'vulkan-icd-loader: 启用 Vulkan 加速'
)
options=(
  '!emptydirs'
  '!strip'
)
source=("${pkgname%-bin}-${pkgver}.rpm::https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/${pkgver}/linux/${_pkgname}-linux-x64.rpm")
sha256sums=('9e3ee6b688d88d8dbb538a5b72e423c37b99fa4b42acdc901a1676d0b850035f')
_get_app_dir() {
	find "${srcdir}" -type f -name "resources.pak" ! -path "*/node_modules/*" -printf '%h\n' 2>/dev/null \
		| while read -r d; do [[ -d "${d}/resources" ]] && { echo "$d"; return 0; }; done
}
_check_electron_version() {
	local _v=$(strings "$(find "$(_get_app_dir)" -maxdepth 1 -type f \
		-executable -printf '%s %p\n' | sort -nr | head -1 | cut -d' ' -f2-)" \
		| grep -oP 'Electron/\K[0-9]+' | head -1)
	[[ -z "$_v" ]] && { echo -e "\033[1;33mNote: Could not check version.\033[0m"; return; }
	(( _v == _electronversion )) && c=32 || c=31
	echo -e "Electron version: \033[1;${c}m$_v$([[ $c -eq 31 ]] && echo " (expected $_electronversion)")\033[0m"
}
package() {
  _check_electron_version
  cp -r "${srcdir}/usr" "${pkgdir}/"
  find "${pkgdir}/usr/share/${pkgname%-bin}/locales" -type f \
    ! -name 'zh-CN.pak' ! -name 'en-US.pak' -delete
  rm -f "${pkgdir}/usr/share/${pkgname%-bin}/LICENSES.chromium.html"
  chmod 755 "${pkgdir}/usr/share/${pkgname%-bin}/${pkgname%-bin}"
  [[ -f "${pkgdir}/usr/share/${pkgname%-bin}/bin/${pkgname%-bin}" ]] && chmod 755 "${pkgdir}/usr/share/${pkgname%-bin}/bin/${pkgname%-bin}"
  [[ -f "${pkgdir}/usr/share/${pkgname%-bin}/chrome-sandbox" ]] && chmod 4755 "${pkgdir}/usr/share/${pkgname%-bin}/chrome-sandbox"
  ln -sf "/usr/bin/ffmpeg" "${pkgdir}/usr/share/${pkgname%-bin}/resources/app/bin/ffmpeg"
  ln -sf "/usr/bin/ffprobe" "${pkgdir}/usr/share/${pkgname%-bin}/resources/app/bin/ffprobe"
  ln -sf "/usr/bin/rg" "${pkgdir}/usr/share/${pkgname%-bin}/resources/app/node_modules/@vscode/ripgrep/bin/rg"
  install -Dm644 "${srcdir}/usr/share/applications/${pkgname%-bin}"*.desktop -t "${pkgdir}/usr/share/applications"
  install -Dm644 "${srcdir}/usr/share/${pkgname%-bin}/resources/app/resources/linux/code.png" "${pkgdir}/usr/share/pixmaps/${pkgname%-bin}.png"
  install -Dm644 "${srcdir}/usr/share/${pkgname%-bin}/resources/completions/bash/${pkgname%-bin}" -t "${pkgdir}/usr/share/bash-completion/completions"
  install -Dm644 "${srcdir}/usr/share/${pkgname%-bin}/resources/completions/zsh/_${pkgname%-bin}" -t "${pkgdir}/usr/share/zsh/vendor-completions"
  install -Dm644 "${srcdir}/usr/share/${pkgname%-bin}/resources/app/LICENSE.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
